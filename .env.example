# ============================================================
# art-site environment template — copy to .env and fill in.
# Load model (server.js): .env loads first, then .env.local
# overrides it. Per-machine settings (sandbox Square creds,
# MAIL_MODE=log) belong in .env.local. Both are gitignored;
# never commit real values.
# ============================================================

# ----- Server -----
# "production" on the deployed box; session cookie `secure` flag keys off this (middleware/session-config.js)
NODE_ENV=development
# Port the Express server listens on (server.js)
PORT=3000
# Secret for signing session cookies (middleware/session-config.js)
SESSION_SECRET=change-me-long-random-string
# Admin login password (controllers/auth-controller.js)
ADMIN_PW=change-me-admin-password
# Public base URL of the site, used in newsletter links (src/newsletter.js)
SITE_URL=https://example.com
# Max upload size in megabytes (src/upload-back.js)
UPLOAD_SIZE_LIMIT_MB=5

# ----- MongoDB -----
# Connection string (middleware/db-config.js, src/migrate-product-slugs.js)
MONGO_URI=mongodb://127.0.0.1:27017
# Database name (middleware/db-config.js)
DB_NAME=art-site
# Collection names (read across src/ and controllers/)
PRODUCTS_COLLECTION=your-products-collection
EVENTS_COLLECTION=your-events-collection
ORDERS_COLLECTION=your-orders-collection
CUSTOMERS_COLLECTION=your-customers-collection
CONTACTS_COLLECTION=your-contacts-collection
SUBSCRIBERS_COLLECTION=your-subscribers-collection
NEWSLETTER_COLLECTION=your-newsletter-collection

# ----- Square -----
# "sandbox" or "production" — unset defaults to production (middleware/square-config.js, controllers/data-controller.js).
# NOTE: sandbox REQUIRES SQUARE_APP_ID and SQUARE_LOCATION_ID below, or /api/square-config returns 500 by design.
SQUARE_ENV=production
# Access token from the Square dashboard — must match SQUARE_ENV (sandbox token for sandbox) (middleware/square-config.js)
SQUARE_TOKEN=replace-with-square-access-token
# Application ID served to the frontend payment form (controllers/data-controller.js)
SQUARE_APP_ID=replace-with-square-app-id
# Location ID for payments and the frontend form (src/payments.js, controllers/data-controller.js)
SQUARE_LOCATION_ID=replace-with-square-location-id

# ----- Mail (Mailgun) -----
# "log" prints mail to console instead of sending; unset/anything else sends for real (src/mailer.js)
MAIL_MODE=send
# Mailgun API base URL (src/mailer.js)
MAILGUN_BASE_URL=https://api.mailgun.net
# Mailgun sending domain (src/mailer.js)
MAILGUN_DOMAIN=mg.example.com
# Mailgun private API key (src/mailer.js)
MAILGUN_API_KEY=replace-with-mailgun-api-key
# From-address for shop mail (src/contact.js, src/newsletter.js, src/orders.js)
EMAIL_USER=shop@example.com
# Admin notification recipients (src/contact.js, src/newsletter.js, src/orders.js)
EMAIL_RECIPIENT_1=admin1@example.com
EMAIL_RECIPIENT_2=admin2@example.com
# From-address for newsletters (src/newsletter.js)
NEWSLETTER_FROM=news@example.com

# ----- Shipping (ShipEngine) -----
# Origin ZIP code packages ship from (src/shipping.js)
SHIPPING_ZIP=00000
# ShipEngine API base URL (src/shipping.js)
SHIP_STATION_BASE_URL=https://api.shipengine.com/v1
# ShipEngine API key (src/shipping.js)
SHIP_STATION_API_KEY=replace-with-shipengine-api-key

# ----- Orders -----
# Sales tax rate as a decimal, e.g. 0.06
TAX_RATE=0.06
