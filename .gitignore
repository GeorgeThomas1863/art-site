# secrets / env files (env-config.js loads .env first, then .env.local overrides)
.env
.env.*
.local.env

# local config repo (cloned by setup script, never committed)
config/
/config*

# agent / tool dirs
.claude
.superpowers
.codex/
.playwright-mcp

# scratch
bugs.txt

# logs
logs
*.log

# vitest coverage output
coverage/

# uploaded images stay out of the repo
**/public/images/products/*
**/public/images/background/*
**/public/images/events/*
**/public/images/newsletter/*

# Dependency directories
node_modules/

# Optional npm cache directory
.npm

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# vitepress build output / cache
**/.vitepress/dist
**/.vitepress/cache

# IDE
.vscode/
.vscode-test

# Windows junk
Thumbs.db
desktop.ini

# ignore markdown (deliberate), with explicit exceptions
*.md
!.env.example
!tests/README.md
