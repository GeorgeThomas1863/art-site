# secrets / env files (env-config.js loads .env first, then .env.local overrides)
.env
.env.*
.local.env

# local config repo (cloned by setup script, never committed)
config/
/config*

# local agent working dirs (same convention as boxes-store)
.claude/pics/
.claude/.pics/
.claude/.tmp/
.claude/screenshots/
.claude/settings.local.json
.remember/
.agents/
.superpowers
.codex/
.playwright-mcp
docs/

# logs
logs
*.log

# vitest coverage output
coverage/

# local backups (mongodump archives + volume tars — never commit)
backups/
*.archive

# uploaded images stay out of the repo (contents only — .gitkeep keeps the dirs)
**/public/images/products/*
!**/public/images/products/.gitkeep
**/public/images/background/*
!**/public/images/background/.gitkeep
**/public/images/events/*
!**/public/images/events/.gitkeep
**/public/images/newsletter/*
!**/public/images/newsletter/.gitkeep

# Dependency directories
node_modules/

# Optional npm cache directory
.npm

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# vitepress build output / cache
**/.vitepress/dist
**/.vitepress/cache

# IDE
.vscode/
.vscode-test

# OS junk
Thumbs.db
desktop.ini
.DS_Store

!.env.example

